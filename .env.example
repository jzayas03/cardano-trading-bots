# Local Postgres from docker-compose.yml (host port 5433; password is local-only, not a secret)
DATABASE_URL=postgres://ctb:ctb_local_only@localhost:5433/ctb
# Read-only connection for `npm run dashboard` (migration 0006 creates the role; the password is
# local-only like ctb_local_only). Leave unset to derive it from DATABASE_URL with that user.
DASHBOARD_DATABASE_URL=
# Blockfrost mainnet project id (https://blockfrost.io). Required by `collect`, not by `migrate`/`status`.
BLOCKFROST_PROJECT_ID=
# Seconds between collector ticks. 600 = 10-minute candles later.
#
# Refresh-budget arithmetic (run 50, 2026-09-06, real key, mainnet): refreshing a pool costs ~10
# Blockfrost calls on these shared-address venues. Refreshing every discovered pool (102 pools) every
# 5 minutes (288 ticks/day) is ~290k calls/day against a 50k/day free quota — 5.8x over. With
# COLLECT_REFRESH=deepest (below) the refreshed set drops to ~20 pools (one per token), and 600s
# ticks (144/day) brings it to ~20 x 10 x 144 = ~28,800 calls/day for refresh, plus discovery's own
# daily cost (~6k/day once Minswap v1 is off, see COLLECT_VENUES below) — comfortably under quota.
COLLECT_INTERVAL_SECONDS=600
# Comma-separated Dexter venue names to discover/refresh (see @ctb/collector VENUE_NAMES). Leave
# unset/blank for the default: every venue except Splash, VyFinance, and Minswap.
# - VyFinance.liquidityPools() rejects with "Not implemented as VyFinance pools are not easily
#   identifiable on-chain," so it would fail every single tick if included.
# - Splash: the installed @indigo-labs/dexter@5.4.10 never returns a Splash pool from either its own
#   unbounded discovery or this repo's bounded per-address/token alternative (a Dexter bug — see
#   packages/collector/src/venues.ts). Measured on the first real tick (run 50, 2026-09-06): 66 min,
#   39,781 Blockfrost calls, 102 pools across the 7 supported venues (Minswap 14, MinswapV2 20,
#   SundaeSwapV1 22, SundaeSwapV3 9, MuesliSwap 12, WingRiders 11, WingRidersV2 14); Splash alone
#   burned roughly 24k of those calls finding nothing.
# - Minswap (v1): discovery alone costs ~9,600 calls/day for 14 shallow pools that are never the
#   deepest pool for their token except AGIX — the deepest pool per token is on Minswap v2 for 19/20
#   tokens, and candles already only use the deepest pool per token per tick (buildCandles in
#   @ctb/candles), so those 14 pools' calls buy nothing the candle pipeline reads.
# All three can still be requested explicitly, e.g. COLLECT_VENUES=Minswap,MinswapV2.
COLLECT_VENUES=
# Which discovered pools `refresh()` spends Blockfrost calls on every tick after discovery.
# - deepest (default): one pool per base token — the pool with the largest ADA reserve — matching
#   what buildCandles (@ctb/candles) actually reads. This is the setting the arithmetic above assumes.
# - all: refresh every discovered pool, as the collector did before this budget was measured. Useful
#   for comparing venues/pools directly, but burns quota fast at a short interval (see the arithmetic
#   above) — use a longer COLLECT_INTERVAL_SECONDS or a narrower COLLECT_VENUES if you need this.
# Fails closed on anything other than "deepest"/"all" (a typo does not silently fall back).
COLLECT_REFRESH=
# Minimum ADA depth for a token's pool to stay in the REFRESH set. Unset or 0 keeps every token,
# which is the behaviour before this option existed. Discovery is unaffected: every venue is still
# scanned and every pool still written on a discovery tick, so a token that gains liquidity rejoins
# on its own.
#
# Why you might set it (measured over the M1 run, 2026-09-07): refresh costs about 14.9 Blockfrost
# calls per pool per tick, so 20 tokens at COLLECT_INTERVAL_SECONDS=600 is ~42,800 calls a day, and
# with one discovery that is 97% of the free tier's 50,000 — one restart pushes it over. Liquidity
# across the seeded universe spans six orders of magnitude (3,180,000 ADA down to 5), and the shallow
# end barely moves: the six tokens under 400,000 ADA changed price on 1.7% to 15.7% of ticks.
#
#   floor       tokens refreshed   calls/day at 600s incl. one discovery   share of the free tier
#   0 (off)     20                 48,600                                  97%
#   400000      13                 33,600                                  67%
#   480000      10                 27,100                                  54%
#   790000       8                 22,900                                  46%
#
# The collector logs exactly which pools it drops, so a narrowed set is visible rather than a hole
# you find later in the candles.
COLLECT_MIN_DEPTH_ADA=
LOG_LEVEL=info

# --- Off-machine backups (optional) -----------------------------------------
# Cloudflare R2, which is S3-compatible. Leave all four blank and `npm run backup`
# writes only to ~/ctb-backups; set all four and it also uploads there.
#
# Setting three of the four is a hard ERROR, not a quiet fall back to local-only:
# believing you have off-site backups when you do not is worse than knowing you
# have none.
#
# To create these: Cloudflare -> R2 -> Create bucket (keep it PRIVATE), then
# Manage API Tokens -> a token scoped to THAT BUCKET ONLY with Object Read & Write.
# R2 lives outside AWS, which keeps trading backups off the account that carries
# regulated workloads.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Tiered sampling (optional) ---------------------------------------------
# Sample ONE token far more often than the rest, inside the same Blockfrost budget.
#
# Why: a candle built from a single sample has open = high = low = close. Every
# candle this project produced before 2026-09-08 did — 2,306 of 2,306, against
# 0.2% in trade-derived data. Several samples per candle is the only way a real
# high and low exist.
#
# Budget, at ~15 calls per pool per tick:
#   1 token at 60s   = 1,440 ticks x 15          = 21,600/day
#   19 tokens at 900s (every 15th tick)          =  6,840/day
#   one discovery                                 =  5,692/day
#                                                  ~34,100 of 50,000
# which is what a flat 900s across 20 tokens already costs.
#
# COLLECT_FOCUS_INTERVAL_SECONDS must DIVIDE COLLECT_INTERVAL_SECONDS, or samples
# straddle candle boundaries and open/close drift. Set both or neither; half a
# configuration is refused rather than half-applied.
COLLECT_FOCUS_TICKER=
COLLECT_FOCUS_INTERVAL_SECONDS=

# Ceiling a DISCOVERY sweep is priced against, in Blockfrost calls. A sweep is ~5,700; if the day's
# spend plus that would exceed this, the tick refuses to discover and says so on the run row.
#
# This is the blast-radius bound, not the fix. The fix is that a restart now restores its pool set
# from the database (migration 0007) and so does not ask for a sweep at all. This catches every other
# way one can be asked for when the quota cannot pay -- a crash loop, an empty universe, a hand-run
# tick. On 2026-09-08 five restarts bought five sweeps, 25,174 of the day's 43,469 calls, and the
# collector spent the rest of the day failing closed on a 402.
#
# Default 45,000 of the 50,000/day free tier: a refused sweep still leaves ~5,000 calls for refresh
# ticks rather than stopping collection outright. 0 disables the check.
COLLECT_DAILY_CALL_CEILING=

# Postgres superuser password for the local container. NOT optional and NOT defaulted: compose uses
# ${POSTGRES_PASSWORD:?...}, so it refuses to start when this is unset or empty.
#
# It used to be the literal `ctb_local_only` inside docker-compose.yml — in a PUBLIC repo, next to a
# port published on 0.0.0.0. See docs/ops/RUNBOOK-postgres-exposure.md.
#
# Must agree with the password inside DATABASE_URL.
POSTGRES_PASSWORD=
