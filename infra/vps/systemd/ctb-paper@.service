[Unit]
Description=CTB paper run (%i)
# On entering `failed` (a one-shot exiting non-zero, or Restart=always hitting StartLimitBurst),
# page via the dead-man's-switch service within seconds instead of at the next watchdog tick.
# Belongs in [Unit], like StartLimit*: systemd silently ignores it under [Service].
# docs/ops/RUNBOOK-alerting.md
OnFailure=ctb-alert@%n.service
After=network-online.target docker.service ctb-collector.service
Wants=network-online.target
Requires=docker.service
# StartLimit* belong in [Unit], NOT [Service]: systemd silently IGNORES them under [Service]
# ("Unknown key name ... ignoring"), so a crash-looping unit would have retried for ever. Caught by
# `systemd-analyze verify` before this reached a host.
# A resume refused because something really IS still writing the run is a real failure — let the
# unit stop rather than loop. Five failures in ten minutes and systemd gives up, which is correct.
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=ctb
WorkingDirectory=/home/ctb/cardano-trading-bots
# NOT `npm run paper` directly: a restart must RESUME this strategy's existing run, never start a
# second equity curve for it. See infra/vps/paper-start.sh.
# %i is `<strategy>_<TICKER>`, e.g. `ma-crossover_SNEK`. The ticker used to be HARDCODED here as
# SNEK, which meant every instance of this template traded the same token and a second instrument
# needed a second template. paper-start.sh splits on the last underscore and refuses anything that
# does not look like a ticker, so a mis-named instance fails loudly instead of trading nothing.
ExecStart=/home/ctb/cardano-trading-bots/infra/vps/paper-start.sh %i --max-gap-min 20
# SIGINT, not systemd's default SIGTERM. The clean-shutdown path — finish the candle in flight,
# record status=finished and stop_reason=signal — is wired to SIGINT. With the default, every
# `systemctl stop` or `restart` killed the process without it, leaving the run `running` with no
# stop_reason: indistinguishable from a crash, and needing the recovery path to come back.
# Observed on all three runs during the NIGHT -> SNEK switch, 2026-09-08.
KillSignal=SIGINT
# Long enough for the in-flight candle to commit before systemd escalates to SIGKILL.
TimeoutStopSec=120
Restart=always
RestartSec=60
StandardOutput=append:/home/ctb/logs/paper-%i.log
StandardError=append:/home/ctb/logs/paper-%i.log

[Install]
WantedBy=multi-user.target
