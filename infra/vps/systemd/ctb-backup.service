[Unit]
Description=CTB backup (dump, upload to R2, verify the remote copy)
# On entering `failed` (a one-shot exiting non-zero, or Restart=always hitting StartLimitBurst),
# page via the dead-man's-switch service within seconds instead of at the next watchdog tick.
# Belongs in [Unit], like StartLimit*: systemd silently ignores it under [Service].
# docs/ops/RUNBOOK-alerting.md
OnFailure=ctb-alert@%n.service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ctb
WorkingDirectory=/home/ctb/cardano-trading-bots
ExecStart=/home/ctb/cardano-trading-bots/scripts/scheduled-backup.sh
StandardOutput=append:/home/ctb/logs/backup.log
StandardError=append:/home/ctb/logs/backup.log
